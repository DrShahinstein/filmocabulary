# unset                       => development for manage.py; production for WSGI/ASGI
# config.settings.development => local SQLite, console email, DEBUG=True
# config.settings.production  => PostgreSQL, production cache/security settings
DJANGO_SETTINGS_MODULE=config.settings.development

# unset    => ''; startup error
# <random> => signs sessions and security-sensitive data; use a unique production value
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# unset => False;
# True  => debug enabled; development forces this value
# False => debug disabled; production forces this value
DEBUG=True

# unset        => localhost,127.0.0.1
# =host1,host2 => accepted hostnames; no scheme or path
ALLOWED_HOSTS=localhost,127.0.0.1

# unset               => []
# https://host[:port] => trusted form origin; comma-separate multiple origins
CSRF_TRUSTED_ORIGINS=


# --------------------------------------------------------------------------------------
# Connect your LLM to power vocabulary generation. See LLM_EXAMPLES at the very bottom.
# Supports any kind of openai-compatible provider.
# --------------------------------------------------------------------------------------

# unset => vocabulary generation fails when requested
# <key> => provider API credential
LLM_API_KEY=replace-with-your-llm-api-key

# unset => gpt-4.1-mini
# <id>  => exact provider model ID, including account/model prefixes
LLM_MODEL=

# unset => https://api.openai.com/v1
# <url> => API root; do not append /chat/completions
LLM_BASE_URL=

# unset     => 180 seconds
# <seconds> => one request timeout; automatic SDK retries remain disabled
LLM_TIMEOUT_SECONDS=180

# unset => ''; provider default; safest for models that reject temperature
# 0     => most deterministic
# 0.7   => more varied; supported range is provider-specific
LLM_TEMPERATURE=

# unset           => ''; provider default; safest for unsupported models
# none            => disable reasoning/thinking when supported
# low|medium|high => provider-specific reasoning effort
LLM_REASONING_EFFORT=

# unset                 => max_tokens; broadly compatible output-token field
# max_completion_tokens => newer reasoning-model output-token field
LLM_MAX_TOKENS_PARAMETER=max_tokens


# ---------------------------------------------------------
# Subtitle acquisition and filtering configuration.
# LLM falls back to its own knowledge without this.
# It works finely that way too, but the vocabulary may be less accurate.
# Using opensubtitles for automatic subtitle acquisition is recommended.
# See opensubtitles.com for free API keys.
# ---------------------------------------------------------

# unset   => 50
# =1..100 => entries preselected in the form; user can change this per request
VOCABULARY_DEFAULT_ITEM_COUNT=50

# unset   => 2097152 bytes (2 MiB)
# <bytes> => maximum .srt/.txt upload size
VOCABULARY_SOURCE_MAX_BYTES=2097152

# unset         => 1100 / 6000 at the 30-item baseline
# higher values => more subtitle context, input tokens, and candidate coverage
VOCABULARY_FILTER_MAX_WORDS=1100      # max word cap for retained subtitle context
VOCABULARY_FILTER_MAX_CHARACTERS=6000 # max character cap for retained subtitle context

# unset => opensubtitles; automatic OpenSubtitles lookup
# ''    => automatic lookup off; use uploads/model knowledge
VOCABULARY_AUTO_SOURCE_PROVIDER=opensubtitles

# unset => ''; automatic lookup fails when requested
# <key> => OpenSubtitles API credential
OPENSUBTITLES_API_KEY=replace-with-your-opensubtitles-api-key

# unset  => Filmocabulary v1.0
# <name> => stable application identifier sent to OpenSubtitles
OPENSUBTITLES_USER_AGENT=Filmocabulary v1.0

# unset     => 20 seconds
# <seconds> => timeout per OpenSubtitles HTTP operation
OPENSUBTITLES_TIMEOUT_SECONDS=20

# unset          => 5/h
# <count>/<unit> => per-user generation limit; units include s, m, h, d
VOCABULARY_GENERATION_RATE=5/h

# unset => True;
# True  => rate limiting enabled
# False => rate limiting disabled
RATELIMIT_ENABLE=True


# -----------------------------------------------------------------------------
# Production
# -----------------------------------------------------------------------------

# unset => ''; production startup error
# <url> =>     PostgreSQL connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# unset                => locmemcache://filmocabulary-production
# redis://HOST:6379/1  => shared cache, recommended for multiple workers
CACHE_URL=redis://localhost:6379/1

# unset => True;
# True  => redirect HTTP to HTTPS
# False => no HTTPS redirect
SECURE_SSL_REDIRECT=True

# unset => False;
# True  => trust a proxy-controlled X-Forwarded-Proto header
# False => ignore X-Forwarded-Proto
TRUST_X_FORWARDED_PROTO=False

# unset     => 31536000 seconds (1year)
# <seconds> => HTTP Strict Transport Security duration
SECURE_HSTS_SECONDS=31536000




# =============================================================================
#                               LLM EXAMPLES
# =============================================================================

# A) OpenAI
# LLM_API_KEY=your-openai-key
# LLM_MODEL=gpt-4.1-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TEMPERATURE=
# LLM_MAX_TOKENS_PARAMETER=max_tokens

# B) Fireworks
# LLM_API_KEY=your-fireworks-key
# LLM_MODEL=accounts/fireworks/models/your-model-name
# LLM_BASE_URL=https://api.fireworks.ai/inference/v1
# LLM_TEMPERATURE=
# LLM_REASONING_EFFORT=none
# LLM_MAX_TOKENS_PARAMETER=max_tokens

# C) Gemini OpenAI-compatible endpoint
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-3.6-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_TEMPERATURE=
# LLM_MAX_TOKENS_PARAMETER=max_tokens

# D) Any other OpenAI-compatible cloud/local endpoint
# LLM_API_KEY=your-provider-key-or-required-placeholder
# LLM_MODEL=your-provider-model-name
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_TEMPERATURE=
# LLM_MAX_TOKENS_PARAMETER=max_tokens




# ============================================================================================
#                            SUBTITLE FILTER PRESETS
# Approximate filtered-source tokens at 30 / 50 / 100 requested entries.
# Excludes prompts, metadata, cached-token rules, and output tokens.
# Django debug console informs how many tokens are actually sent to the LLM for each request.
# ============================================================================================

# EXAMPLE 1 — lowest: ~875 / 1,170 / 2,040 tokens
# VOCABULARY_FILTER_MAX_WORDS=650
# VOCABULARY_FILTER_MAX_CHARACTERS=3500

# EXAMPLE 2 — low: ~1,500 / 2,000 / 3,500 tokens
# VOCABULARY_FILTER_MAX_WORDS=1100
# VOCABULARY_FILTER_MAX_CHARACTERS=6000

# EXAMPLE 3 — mid: ~2,250 / 3,000 / 5,250 tokens
# VOCABULARY_FILTER_MAX_WORDS=1600
# VOCABULARY_FILTER_MAX_CHARACTERS=9000

# EXAMPLE 4 — high: ~3,000 / 4,000 / 7,000 tokens
# VOCABULARY_FILTER_MAX_WORDS=2200
# VOCABULARY_FILTER_MAX_CHARACTERS=12000                      -- I use this.
