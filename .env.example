# Copy this file to .env, then replace placeholders for your environment.
# Never commit .env or place real API keys in source code, templates, logs, or chat.

# -----------------------------------------------------------------------------
# Django application
# -----------------------------------------------------------------------------

# Settings profile used by local Django commands. manage.py defaults to development;
# the WSGI and ASGI production entry points default to production.
DJANGO_SETTINGS_MODULE=config.settings.development

# Secret used to sign sessions and security-sensitive data. Replace this with a long,
# random value. Every production deployment must have a private, unique secret.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# Enables Django debug behavior in base settings. Development forces this on and
# production forces it off. Never run a public deployment with debug enabled.
DEBUG=True

# Comma-separated hostnames that may serve the application. Do not include paths.
# Production example: filmocabulary.example.com,www.filmocabulary.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated trusted form origins, including https:// and any non-default port.
# Usually blank locally. Example: https://filmocabulary.example.com
CSRF_TRUSTED_ORIGINS=

# -----------------------------------------------------------------------------
# Universal vocabulary LLM
# -----------------------------------------------------------------------------

# API credential issued by your LLM provider. Required for vocabulary generation.
LLM_API_KEY=

# Exact model identifier accepted by the provider, including any account/model prefix.
LLM_MODEL=gpt-4.1-mini

# Provider API root. Do not append /chat/completions; the client adds that path.
# The endpoint must support OpenAI-compatible Chat Completions and JSON Schema output.
LLM_BASE_URL=https://api.openai.com/v1

# Maximum time, in seconds, allowed for one LLM request. Filmocabulary disables
# automatic SDK retries to preserve its single-shot generation behavior.
LLM_TIMEOUT_SECONDS=180

# Controls output randomness. Lower values are more consistent; higher values are
# more varied. For structured vocabulary extraction, 0 is a sensible starting point.
# Leave blank if the model does not support temperature or should use its own default.
LLM_TEMPERATURE=

# Controls reasoning/thinking effort on models that expose this parameter. Use none
# to disable reasoning when supported. Leave blank for unsupported models or to use
# the provider default; an unsupported value may cause the provider to reject a call.
LLM_REASONING_EFFORT=

# Name of the Chat Completions field used for the scaled output-token allowance.
# Use max_tokens for broadly compatible/non-reasoning APIs. Use max_completion_tokens
# when required by a newer reasoning model. Those are the only supported values.
LLM_MAX_TOKENS_PARAMETER=max_tokens

# -----------------------------------------------------------------------------
# Vocabulary generation and subtitle processing
# -----------------------------------------------------------------------------

# Number of new vocabulary entries preselected in the generation form. Users may
# change it per request; valid application requests range from 1 to 100.
VOCABULARY_DEFAULT_ITEM_COUNT=12

# Largest accepted .srt or .txt upload in bytes. 2097152 bytes equals 2 MiB.
VOCABULARY_SOURCE_MAX_BYTES=2097152

# N=30 subtitle-filter baseline. MAX_WORDS caps retained words and MAX_CHARACTERS
# caps retained characters; the lower effective cap wins. Budgets scale down for
# small requests and up to about 2.33x for 100 requested entries. Higher values send
# more subtitle context, may improve candidate coverage, and cost more input tokens.
VOCABULARY_FILTER_MAX_WORDS=1100
VOCABULARY_FILTER_MAX_CHARACTERS=6000

# Automatic subtitle source integration. Use opensubtitles to enable it or leave the
# value blank to rely on uploads/model knowledge. This setting is unrelated to LLM_BASE_URL.
VOCABULARY_AUTO_SOURCE_PROVIDER=opensubtitles

# OpenSubtitles API credential. Required only when automatic lookup is enabled.
OPENSUBTITLES_API_KEY=

# Application identifier sent to OpenSubtitles. Use a stable, descriptive value.
OPENSUBTITLES_USER_AGENT=Filmocabulary v1.0

# Maximum time, in seconds, for each OpenSubtitles HTTP operation.
OPENSUBTITLES_TIMEOUT_SECONDS=20

# Per-user vocabulary-generation request limit in django-ratelimit syntax.
# Example: 5/h allows five requests per authenticated user per hour.
VOCABULARY_GENERATION_RATE=5/h

# Enables generation rate limiting. Keep True for shared or public deployments.
RATELIMIT_ENABLE=True

# -----------------------------------------------------------------------------
# Production-only infrastructure
# -----------------------------------------------------------------------------

# PostgreSQL connection URL used by production settings.
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME
DATABASE_URL=

# Shared cache URL used by production. Redis is recommended for multiple workers so
# rate limits and duplicate-answer protection do not become process-local.
CACHE_URL=redis://localhost:6379/1

# Redirects HTTP requests to HTTPS in production. Keep True unless TLS is handled in
# a development environment where the redirect would prevent access.
SECURE_SSL_REDIRECT=True

# Trusts X-Forwarded-Proto=https when Django is behind a trusted reverse proxy.
# Enable only when that proxy strips client-supplied headers and sets its own value.
TRUST_X_FORWARDED_PROTO=False

# =============================================================================
# READY-TO-COPY LLM EXAMPLES
# Replace the active LLM_* values above with ONE example. Lines stay commented here
# so this file contains only one active value for each environment variable.
# =============================================================================

# A) OpenAI
# LLM_API_KEY=your-openai-key
# LLM_MODEL=gpt-4.1-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TEMPERATURE=0
# LLM_REASONING_EFFORT=
# LLM_MAX_TOKENS_PARAMETER=max_tokens

# B) Fireworks
# LLM_API_KEY=your-fireworks-key
# LLM_MODEL=accounts/fireworks/models/your-model-name
# LLM_BASE_URL=https://api.fireworks.ai/inference/v1
# LLM_TEMPERATURE=0
# LLM_REASONING_EFFORT=none
# LLM_MAX_TOKENS_PARAMETER=max_tokens

# C) Gemini through its OpenAI-compatible endpoint
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-3.6-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_TEMPERATURE=0
# LLM_REASONING_EFFORT=
# LLM_MAX_TOKENS_PARAMETER=max_tokens

# D) Another OpenAI-compatible cloud or local endpoint
# LLM_API_KEY=your-provider-key-or-required-placeholder
# LLM_MODEL=your-provider-model-name
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_TEMPERATURE=0
# LLM_REASONING_EFFORT=
# LLM_MAX_TOKENS_PARAMETER=max_tokens

# =============================================================================
# SUBTITLE FILTER PRESETS
# Choose ONE pair for VOCABULARY_FILTER_MAX_WORDS / MAX_CHARACTERS above.
# Token figures are rough filtered-subtitle input estimates using ~4 characters per
# token. They exclude prompts, metadata, cached-token rules, and model output. Actual
# usage varies by subtitle language, dialogue, tokenizer, available advanced terms,
# and provider; short sources commonly use less than these scaled character caps.
# Estimates below correspond to requests for 12 / 30 / 50 / 100 saved entries.
# =============================================================================

# Level 1 - Economy: cheapest; least dialogue context and greatest shortfall risk.
# Approx source tokens: 700 / 875 / 1,170 / 2,040.
# VOCABULARY_FILTER_MAX_WORDS=650
# VOCABULARY_FILTER_MAX_CHARACTERS=3500

# Level 2 - Balanced (default): recommended cost/coverage balance.
# Approx source tokens: 1,190 / 1,500 / 2,000 / 3,500.
# VOCABULARY_FILTER_MAX_WORDS=1100
# VOCABULARY_FILTER_MAX_CHARACTERS=6000

# Level 3 - Rich context: more evidence for long or vocabulary-dense films.
# Approx source tokens: 1,785 / 2,250 / 3,000 / 5,250.
# VOCABULARY_FILTER_MAX_WORDS=1600
# VOCABULARY_FILTER_MAX_CHARACTERS=9000

# Level 4 - Maximum context: highest input cost and possible diminishing returns.
# Approx source tokens: 2,380 / 3,000 / 4,000 / 7,000.
# VOCABULARY_FILTER_MAX_WORDS=2200
# VOCABULARY_FILTER_MAX_CHARACTERS=12000
