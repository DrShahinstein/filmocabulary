DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Select openai, gemini, or fireworks. Only the selected provider's key is required.
# Keys are read server-side only. Never expose them in templates or JavaScript.
VOCABULARY_LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=180

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=180

FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731
FIREWORKS_TIMEOUT_SECONDS=180

VOCABULARY_DEFAULT_ITEM_COUNT=12
VOCABULARY_SOURCE_MAX_BYTES=2097152
# N=30 baseline; smaller requests use less and larger requests scale to ~2.33x.
# Complete filtered B1-C2 subtitle units are selected under both limits.
VOCABULARY_FILTER_MAX_WORDS=1100
VOCABULARY_FILTER_MAX_CHARACTERS=6000
# Set this blank to disable automatic English-subtitle lookup.
VOCABULARY_AUTO_SOURCE_PROVIDER=opensubtitles
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER_AGENT=Filmocabulary v1.0
OPENSUBTITLES_TIMEOUT_SECONDS=20
VOCABULARY_GENERATION_RATE=5/h
RATELIMIT_ENABLE=True

# Production only. Example format: postgresql://USER:PASSWORD@HOST:5432/NAME
DATABASE_URL=
CACHE_URL=redis://localhost:6379/1
SECURE_SSL_REDIRECT=True
TRUST_X_FORWARDED_PROTO=False
