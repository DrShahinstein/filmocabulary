# -----------------------------------------------------------------------------
# Django application
# -----------------------------------------------------------------------------
# Development is the safe default for manage.py. Production entry points select
# config.settings.production automatically.
DJANGO_SETTINGS_MODULE=config.settings.development

# Required. Replace this placeholder with a long, random value and never commit
# the resulting .env file. Production must use its own strong secret.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# These defaults are intended for local development only.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins including the scheme, for example https://example.com.
CSRF_TRUSTED_ORIGINS=

# -----------------------------------------------------------------------------
# Universal vocabulary LLM
# -----------------------------------------------------------------------------
# Filmocabulary uses the OpenAI-compatible Chat Completions protocol with JSON
# Schema structured outputs. There is no provider selector or provider allowlist.
# The endpoint must support POST /chat/completions and response_format=json_schema.
# Keys stay server-side; never expose them in templates, JavaScript, logs, or chat.

# Required when vocabulary generation is used.
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Set this to the provider's API root, not the full /chat/completions URL.
# The default below connects to OpenAI. Common alternatives include:
# Gemini:   https://generativelanguage.googleapis.com/v1beta/openai/
# Fireworks: https://api.fireworks.ai/inference/v1
LLM_BASE_URL=https://api.openai.com/v1

# Total request timeout in seconds. Automatic SDK retries remain disabled so one
# application generation attempt cannot silently become several provider calls.
LLM_TIMEOUT_SECONDS=180

# Optional model controls. Leave either value blank to use the provider default.
# Use LLM_REASONING_EFFORT=none for compatible models where reasoning/thinking
# should be disabled. Only set a value that the selected model supports.
LLM_TEMPERATURE=
LLM_REASONING_EFFORT=

# Filmocabulary preserves its output allowance of 512 + 160 tokens per requested
# candidate. Most compatible endpoints accept max_tokens. Use
# max_completion_tokens when required by a newer reasoning model or provider.
# Supported values: max_tokens, max_completion_tokens.
LLM_MAX_TOKENS_PARAMETER=max_tokens

# -----------------------------------------------------------------------------
# Vocabulary generation and subtitle processing
# -----------------------------------------------------------------------------
VOCABULARY_DEFAULT_ITEM_COUNT=12

# Maximum accepted .srt/.txt upload size in bytes (2 MiB by default).
VOCABULARY_SOURCE_MAX_BYTES=2097152

# N=30 baseline. Smaller requests use less context; larger requests scale up to
# roughly 2.33x. Complete filtered B1-C2 dialogue units stay intact.
VOCABULARY_FILTER_MAX_WORDS=1100
VOCABULARY_FILTER_MAX_CHARACTERS=6000

# Set the provider blank to disable automatic English-subtitle lookup. Users can
# still upload an .srt or .txt source or fall back to model knowledge.
VOCABULARY_AUTO_SOURCE_PROVIDER=opensubtitles
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER_AGENT=Filmocabulary v1.0
OPENSUBTITLES_TIMEOUT_SECONDS=20

# Per-authenticated-user vocabulary generation limit.
VOCABULARY_GENERATION_RATE=5/h
RATELIMIT_ENABLE=True

# -----------------------------------------------------------------------------
# Production-only infrastructure
# -----------------------------------------------------------------------------
# Example: postgresql://USER:PASSWORD@HOST:5432/NAME
DATABASE_URL=

# Optional but recommended for multi-process deployments. Redis provides a cache
# shared by all workers; change or remove this example for your environment.
CACHE_URL=redis://localhost:6379/1

SECURE_SSL_REDIRECT=True
# Enable only when a trusted reverse proxy sets X-Forwarded-Proto correctly.
TRUST_X_FORWARDED_PROTO=False
