# Local commands use development by default; WSGI/ASGI use production.
DJANGO_SETTINGS_MODULE=config.settings.development

# Required. Use a long, random, private value in every deployment.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# Development forces True and production forces False.
DEBUG=True

# Comma-separated hostnames, without schemes or paths.
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional. Include the scheme and port; comma-separate multiple origins.
# CSRF_TRUSTED_ORIGINS=https://filmocabulary.example.com



# -----------------------------------------------------------------------------
# LLM
# -----------------------------------------------------------------------------

# Requires an OpenAI-compatible Chat Completions endpoint with JSON Schema
# structured outputs. Provider examples are at the bottom of this file.

# Required for vocabulary generation.
LLM_API_KEY=replace-with-your-llm-api-key

# Exact provider model ID. Default: gpt-4.1-mini.
LLM_MODEL=gpt-4.1-mini

# API root only; do not append /chat/completions. Default: https://api.openai.com/v1.
LLM_BASE_URL=https://api.openai.com/v1

# Request timeout in seconds. SDK retries remain disabled. Default: 180.
LLM_TIMEOUT_SECONDS=180

# Optional. Omit to use the provider default. Lower values are more consistent;
# higher values are more varied. Some models reject this parameter.
# LLM_TEMPERATURE=0

# Optional. Omit unless the model supports reasoning controls.
# Common values include none, low, medium, and high; support varies by provider.
# LLM_REASONING_EFFORT=none

# Output-token field: max_tokens or max_completion_tokens.
LLM_MAX_TOKENS_PARAMETER=max_tokens



# -----------------------------------------------------------------------------
# Vocabulary and subtitles
# -----------------------------------------------------------------------------

# Form's initial item count (1-100). Application default: 12; this example: 50.
VOCABULARY_DEFAULT_ITEM_COUNT=50

# Maximum .srt or .txt upload size in bytes. Default: 2097152 (2 MiB).
VOCABULARY_SOURCE_MAX_BYTES=2097152

# Subtitle context retained at the 30-item baseline. The budget scales with the
# requested item count; the lower effective cap wins. Presets are below.
VOCABULARY_FILTER_MAX_WORDS=1100
VOCABULARY_FILTER_MAX_CHARACTERS=6000

# opensubtitles enables automatic lookup. Leave this variable empty to disable
# lookup and rely on uploads or model knowledge. Default: opensubtitles.
VOCABULARY_AUTO_SOURCE_PROVIDER=opensubtitles

# Required only for automatic OpenSubtitles lookup.
OPENSUBTITLES_API_KEY=replace-with-your-opensubtitles-api-key

# Application identifier sent to OpenSubtitles.
OPENSUBTITLES_USER_AGENT=Filmocabulary v1.0

# Timeout per OpenSubtitles HTTP operation, in seconds. Default: 20.
OPENSUBTITLES_TIMEOUT_SECONDS=20

# Per-user generation limit in django-ratelimit syntax. Default: 5/h.
VOCABULARY_GENERATION_RATE=5/h

# Keep enabled for shared or public deployments.
RATELIMIT_ENABLE=False



# -----------------------------------------------------------------------------
# Production
# -----------------------------------------------------------------------------

# Required by production settings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# Redis is recommended for shared rate limits and cache state across workers.
# Production falls back to a process-local cache when this variable is absent.
CACHE_URL=redis://localhost:6379/1

# Redirect HTTP to HTTPS. Default: True.
SECURE_SSL_REDIRECT=True

# Enable only behind a trusted proxy that controls X-Forwarded-Proto.
TRUST_X_FORWARDED_PROTO=False

# HTTP Strict Transport Security duration in seconds. Default: one year.
SECURE_HSTS_SECONDS=31536000







# =============================================================================
# LLM EXAMPLES
# Replace the active LLM_* block above with one provider configuration.
# Optional parameters should be omitted when the selected model rejects them.
# =============================================================================

# A) OpenAI
# LLM_API_KEY=your-openai-key
# LLM_MODEL=gpt-4.1-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT_SECONDS=180
# LLM_MAX_TOKENS_PARAMETER=max_tokens

# B) Fireworks
# LLM_API_KEY=your-fireworks-key
# LLM_MODEL=accounts/fireworks/models/your-model-name
# LLM_BASE_URL=https://api.fireworks.ai/inference/v1
# LLM_TIMEOUT_SECONDS=180
# LLM_TEMPERATURE=0
# LLM_REASONING_EFFORT=none
# LLM_MAX_TOKENS_PARAMETER=max_tokens

# C) Gemini OpenAI-compatible endpoint
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-3.6-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_TIMEOUT_SECONDS=180
# LLM_TEMPERATURE=0
# LLM_MAX_TOKENS_PARAMETER=max_tokens

# D) Another compatible cloud or local endpoint
# LLM_API_KEY=your-provider-key-or-required-placeholder
# LLM_MODEL=your-provider-model-name
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_TIMEOUT_SECONDS=180
# LLM_TEMPERATURE=0
# LLM_MAX_TOKENS_PARAMETER=max_tokens




# =============================================================================
# SUBTITLE FILTER PRESETS
# Approximate filtered-source tokens at 30 / 50 / 100 requested entries.
# Figures exclude prompts, metadata, cached-token rules, and output tokens.
# =============================================================================

# EXAMPLE 1 - Lowest: ~875 / 1,170 / 2,040 tokens
# VOCABULARY_FILTER_MAX_WORDS=650
# VOCABULARY_FILTER_MAX_CHARACTERS=3500

# EXAMPLE 2 - Low (default): ~1,500 / 2,000 / 3,500 tokens
# VOCABULARY_FILTER_MAX_WORDS=1100
# VOCABULARY_FILTER_MAX_CHARACTERS=6000

# EXAMPLE 3 - Medium: ~2,250 / 3,000 / 5,250 tokens
# VOCABULARY_FILTER_MAX_WORDS=1600
# VOCABULARY_FILTER_MAX_CHARACTERS=9000

# EXAMPLE 4 - High (recommended): ~3,000 / 4,000 / 7,000 tokens
# VOCABULARY_FILTER_MAX_WORDS=2200
# VOCABULARY_FILTER_MAX_CHARACTERS=12000        -- I use this.
